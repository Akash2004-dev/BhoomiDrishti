# Required for live visual analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Earth Engine becomes explicitly unavailable if these are not set up.
GOOGLE_APPLICATION_CREDENTIALS=sa-credentials.json
GEE_SERVICE_ACCOUNT=
GEE_PROJECT_ID=

# Comma-separated browser origins. Use the local default for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
